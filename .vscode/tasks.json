{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build PrviLabos",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PrviLabos/PrviLabos.csproj"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "run PrviLabos and open browser",
            "command": "powershell",
            "type": "process",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "Start-Job -ScriptBlock { Start-Sleep -Seconds 3; Start-Process 'https://localhost:7002/racun/prijava' } | Out-Null; dotnet run --project '${workspaceFolder}/PrviLabos/PrviLabos.csproj' --launch-profile https"
            ],
            "problemMatcher": "$msCompile",
            "isBackground": true
        }
    ]
}
