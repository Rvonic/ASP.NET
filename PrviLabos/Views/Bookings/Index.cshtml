@model IEnumerable<PrviLabos.Model.Booking>
@{
    ViewData["Title"] = "Bookings";
}

@section Breadcrumbs {
    <nav class="ux-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span>/</span>
        <span class="ux-breadcrumb-current" aria-current="page">Bookings</span>
    </nav>
}

<div class="ux-location-page-actions">
    <a class="ux-button-primary" asp-action="Create">
        <span class="ux-button-primary-icon" aria-hidden="true">+</span>
        <span>New Booking</span>
        <span class="ux-button-primary-caret" aria-hidden="true">&#x2304;</span>
    </a>
</div>

<section class="ux-surface-card">
    <header class="ux-panel-header ux-location-panel-header">
        <div>
            <h2 class="ux-section-title">Reservation Queue</h2>
        </div>
        <div class="ux-location-search-shell">
            <label class="visually-hidden" for="booking-search">Search bookings</label>
            <svg class="ux-location-search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
                <path d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
            </svg>
            <input id="booking-search"
                   class="form-control ux-location-search ux-booking-search"
                   type="search"
                   aria-label="Search bookings"
                   placeholder="Booking search"
                   autocomplete="off"
                   data-ux-booking-search />
        </div>
    </header>
    <div class="ux-table-wrap">
        <table class="ux-table" data-ux-booking-table>
            <thead>
                <tr>
                    <th>Reservation</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Route</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody data-ux-booking-table-body>
                @await Html.PartialAsync("_BookingRows", Model)
            </tbody>
        </table>
    </div>
</section>
