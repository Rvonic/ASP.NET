@model IEnumerable<PrviLabos.Model.Vehicle>
@{
    ViewData["Title"] = "Vehicles";
}

@section Breadcrumbs {
    <nav class="ux-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span>/</span>
        <span class="ux-breadcrumb-current" aria-current="page">Vehicles</span>
    </nav>
}

<div class="ux-location-page-actions">
    <a class="ux-button-primary" asp-action="Create">
        <span class="ux-button-primary-icon" aria-hidden="true">+</span>
        <span>New Vehicle</span>
        <span class="ux-button-primary-caret" aria-hidden="true">&#x2304;</span>
    </a>
</div>

<section class="ux-surface-card">
    <header class="ux-panel-header ux-location-panel-header">
        <div>
            <h2 class="ux-section-title">Fleet Directory</h2>
        </div>
        <div class="ux-location-search-shell">
            <label class="visually-hidden" for="vehicle-search">Search vehicles</label>
            <svg class="ux-location-search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
                <path d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
            </svg>
            <input id="vehicle-search"
                   class="form-control ux-location-search ux-vehicle-search"
                   type="search"
                   aria-label="Search vehicles"
                   placeholder="Vehicle search"
                   autocomplete="off"
                   data-ux-vehicle-search />
        </div>
    </header>
    <div class="ux-table-wrap">
        <table class="ux-table" data-ux-vehicle-table>
            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Plate</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th>Availability</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody data-ux-vehicle-table-body>
                @await Html.PartialAsync("_VehicleRows", Model)
            </tbody>
        </table>
    </div>
</section>
